# ============================================================================
# 2008Pars — نمونه متغیرهای محیطی
# ----------------------------------------------------------------------------
# این فایل الگوست و در Git می‌ماند.
# فایل واقعی .env هرگز نباید commit شود (در .gitignore هست).
# هیچ رمز واقعی‌ای در این فایل ننویسید.
# ============================================================================

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# ------------------------------------------------------------- پایگاه داده
# تنها PostgreSQL پشتیبانی می‌شود.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/pars2008
# on | no-verify | off   (خالی = در تولید روشن، در توسعه خاموش)
#
# هشدار — تقدم sslmode بر DATABASE_SSL:
# اگر DATABASE_URL پارامتر «sslmode» داشته باشد، node-postgres خودش آن را
# تجزیه می‌کند و نتیجه‌اش بر شیء DATABASE_SSL تقدم دارد؛ یعنی DATABASE_SSL
# بی‌سروصدا بی‌اثر می‌شود.
#
# این ترکیب کار نمی‌کند:
#   DATABASE_URL با «?sslmode=require»  +  DATABASE_SSL=no-verify
#   → sslmode برنده می‌شود، گواهی بررسی می‌شود، و اتصال به ارائه‌دهنده‌ای
#     با گواهی خودامضا با خطای «self-signed certificate in certificate
#     chain» شکست می‌خورد.
#
# الگوی پیشنهادی — یکی را انتخاب کنید، نه هر دو:
#   الف) «sslmode» را از DATABASE_URL بردارید و فقط DATABASE_SSL را تنظیم
#        کنید. (توصیه‌شده: کنترل در یک جا می‌ماند.)
#   ب) «sslmode» را داخل DATABASE_URL بگذارید و DATABASE_SSL را خالی رها کنید.
DATABASE_SSL=
DATABASE_POOL_MAX=10
# مهلت برقراری اتصال و مهلت بی‌کاری اتصال (میلی‌ثانیه)
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------ نشست
# نشست مشتری (هنوز پیاده نشده). نشست مدیر تنظیمات جدای خودش را دارد.
SESSION_COOKIE_NAME=pars_session
CSRF_COOKIE_NAME=pars_csrf
SESSION_DAYS=30

# -------------------------------------------------------- نشست مدیر
# کوکی مدیر فقط زیر /admin فرستاده می‌شود.
ADMIN_COOKIE_NAME=pars_admin_session
ADMIN_CSRF_COOKIE_NAME=pars_admin_csrf
# سقف مطلق عمر نشست (ساعت)
ADMIN_SESSION_ABSOLUTE_HOURS=12
# بی‌کاری مجاز (دقیقه)
ADMIN_SESSION_IDLE_MINUTES=60
# قفل شدن پس از تلاش ناموفق، در پنجره زمانی زیر
ADMIN_LOGIN_MAX_PER_IDENTIFIER=5
ADMIN_LOGIN_MAX_PER_IP=20
ADMIN_LOGIN_WINDOW_MINUTES=15

# --------------------------------------------------------------- Argon2id
ARGON_MEMORY_KIB=19456
ARGON_TIME=2
ARGON_PARALLELISM=1

# ------------------------------------------------------------ ذخیره‌سازی
# بیرون از webroot. originals و receipts هرگز عمومی سرو نمی‌شوند.
STORAGE_ROOT=
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_RECEIPT_BYTES=5242880
UPLOAD_MAX_RECEIPTS_PER_ORDER=5

# ------------------------------------------------- تصویر محصول (فاز ۵)
# سقف تعداد فایل در یک درخواست آپلود.
UPLOAD_MAX_FILES_PER_REQUEST=8
# سقف تصویر برای هر محصول.
UPLOAD_MAX_IMAGES_PER_PRODUCT=8
# کمینهٔ ضلع بزرگ‌ترِ تصویر ورودی (پیکسل). زیر این اندازه، مشتق ۴۰۰
# پیکسلیِ کارت محصول پر نمی‌شود.
UPLOAD_MIN_IMAGE_DIMENSION=400
# سقف شمار پیکسل تصویر ورودی. جلوی «بمب فشرده‌سازی» را می‌گیرد: فایل
# کوچکِ فشرده که هنگام باز شدن گیگابایت‌ها حافظه می‌خواهد.
UPLOAD_MAX_IMAGE_PIXELS=50000000

# ---------------------------------------------------------------- تصویر
WATERMARK_ENABLED=true
# فایل نشانِ واترمارک. پیش‌فرض، نشان برند داخل خود مخزن است.
WATERMARK_FILE=
IMAGE_WEBP_QUALITY=82
IMAGE_JPEG_QUALITY=84

# ----------------------------------------------------------- محدودیت نرخ
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_UPLOAD_MAX=10

# ----------------------------------------------------------------- پیامک
# ارائه‌دهنده هنوز انتخاب نشده است (فاز بعد).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
SMS_MANAGER_MOBILE=
