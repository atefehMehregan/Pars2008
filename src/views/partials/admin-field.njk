{# ============================================================================
   کادرهای فرم مدیر — ماکروهای مشترک.
   یک جا تعریف می‌شوند تا برچسب، خطا و فاصله‌گذاری در همهٔ فرم‌ها یکی
   باشد و هر فرم تازه‌ای همان رفتار را رایگان بگیرد.
   ========================================================================= #}

{% macro text(name, label, value, errors, type='text', required=false, hint='', dir='') %}
  <div class="field{% if errors[name] %} field--invalid{% endif %}">
    <label class="field__label" for="f-{{ name }}">
      {{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}
    </label>
    <input class="field__input" id="f-{{ name }}" name="{{ name }}" type="{{ type }}"
           value="{{ value if value is not none else '' }}"
           {% if dir %}dir="{{ dir }}"{% endif %}
           {% if errors[name] %}aria-invalid="true" aria-describedby="e-{{ name }}"{% endif %} />
    {% if hint %}<p class="field__hint">{{ hint }}</p>{% endif %}
    {% if errors[name] %}<p class="field__error" id="e-{{ name }}">{{ errors[name] }}</p>{% endif %}
  </div>
{% endmacro %}

{% macro textarea(name, label, value, errors, rows=4, hint='') %}
  <div class="field{% if errors[name] %} field--invalid{% endif %}">
    <label class="field__label" for="f-{{ name }}">{{ label }}</label>
    <textarea class="field__input field__input--area" id="f-{{ name }}" name="{{ name }}"
              rows="{{ rows }}"
              {% if errors[name] %}aria-invalid="true" aria-describedby="e-{{ name }}"{% endif %}
    >{{ value if value is not none else '' }}</textarea>
    {% if hint %}<p class="field__hint">{{ hint }}</p>{% endif %}
    {% if errors[name] %}<p class="field__error" id="e-{{ name }}">{{ errors[name] }}</p>{% endif %}
  </div>
{% endmacro %}

{#  options: فهرستی از {value, label} #}
{% macro select(name, label, value, errors, options, placeholder='—', required=false) %}
  <div class="field{% if errors[name] %} field--invalid{% endif %}">
    <label class="field__label" for="f-{{ name }}">
      {{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}
    </label>
    <select class="field__input" id="f-{{ name }}" name="{{ name }}"
            {% if errors[name] %}aria-invalid="true" aria-describedby="e-{{ name }}"{% endif %}>
      {% if not required or not value %}<option value="">{{ placeholder }}</option>{% endif %}
      {% for opt in options %}
        <option value="{{ opt.value }}"
          {% if value is not none and (value | string) == (opt.value | string) %}selected{% endif %}>
          {{ opt.label }}
        </option>
      {% endfor %}
    </select>
    {% if errors[name] %}<p class="field__error" id="e-{{ name }}">{{ errors[name] }}</p>{% endif %}
  </div>
{% endmacro %}

{% macro check(name, label, checked, hint='') %}
  <div class="field field--check">
    <label class="check">
      <input type="checkbox" name="{{ name }}" value="on" {% if checked %}checked{% endif %} />
      <span>{{ label }}</span>
    </label>
    {% if hint %}<p class="field__hint">{{ hint }}</p>{% endif %}
  </div>
{% endmacro %}
