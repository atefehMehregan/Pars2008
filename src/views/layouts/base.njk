<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ metaDescription | default('فروشگاه اینترنتی قطعات یدکی پژو ۲۰۰۸') }}" />
    <meta name="theme-color" content="#123a5e" />
    <title>{{ title }} | {{ storeName }}</title>
    {# نشان برند. SVG برای مرورگرهای امروزی، و PNG مات برای آیکون iOS —
       iOS آیکون شفاف را روی زمینهٔ سیاه می‌نشاند. #}
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="/css/base.css" />
  </head>

  <body>
    <a class="skip-link" href="#main">پرش به محتوای اصلی</a>

    {% include "partials/site-header.njk" %}

    <main id="main">
      {% block content %}{% endblock %}
    </main>

    {% include "partials/site-footer.njk" %}
  </body>
</html>
